# ElectroMart Frontend Environment Variables
# In production on Vercel Services, both frontend and backend share the same domain,
# so requests use the relative path '/api' routed via vercel.json rewrites.
# For local development with standalone servers, you can use '/api' (proxied by Vite) or full URL.
VITE_API_BASE_URL=/api
VITE_APP_NAME="ElectroMart Sri Lanka"
